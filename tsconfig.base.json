{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": false,

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@affiant/adapter-ai-sdk": ["./packages/adapter-ai-sdk/src/index.ts"],
      "@affiant/adapter-ai-sdk/inference": ["./packages/adapter-ai-sdk/src/inference.ts"],
      "@affiant/contract": ["./packages/contract/src/index.ts"],
      "@affiant/contract/schemas": ["./packages/contract/src/schemas.ts"],
      "@affiant/contract/conformance": ["./packages/contract/src/conformance.ts"],
      "@affiant/core": ["./packages/core/src/index.ts"],
      "@affiant/core/store-memory": ["./packages/core/src/store-memory.ts"],
      "@affiant/core/testing": ["./packages/core/src/testing.ts"],
      "@affiant/conformance-driver": ["./packages/conformance-driver/src/index.ts"],
      "@affiant/store-postgres": ["./packages/store-postgres/src/index.ts"],
      "@affiant/store-postgres/migrations": ["./packages/store-postgres/src/migrations.ts"]
    }
  }
}
