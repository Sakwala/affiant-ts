{
  "name": "affiant-ts",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sakwala/affiant-ts.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "prettier --check . && node scripts/lint-no-internal-refs.mjs && pnpm -r --workspace-concurrency=1 --if-present lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
