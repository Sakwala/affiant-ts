{
  "name": "@affiant/evidence-card",
  "version": "0.1.0-alpha.0",
  "description": "<affiant-evidence-card>, a dependency-free custom element that renders an Affiant Affidavit for a person to approve, amend or reject.",
  "keywords": [
    "affiant",
    "web-component",
    "custom-element",
    "provenance",
    "human-in-the-loop",
    "ai-agents"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sakwala/affiant-ts.git",
    "directory": "packages/evidence-card"
  },
  "homepage": "https://github.com/Sakwala/affiant-ts/tree/main/packages/evidence-card#readme",
  "bugs": "https://github.com/Sakwala/affiant-ts/issues",
  "sideEffects": [
    "./dist/register.js",
    "./src/register.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-demo.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@affiant/contract": "workspace:^"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^19.0.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
