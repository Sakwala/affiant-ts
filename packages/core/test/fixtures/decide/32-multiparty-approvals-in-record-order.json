              "approvers": ["ana", "bo", "cy"],
              "required": 3
            }
          }
        }
      ]
    },
    "ctx": {
      "tenantId": "tenant-a",
      "conversationId": "conv-1",
      "channel": "chat",
      "principal": {
        "kind": "member",
