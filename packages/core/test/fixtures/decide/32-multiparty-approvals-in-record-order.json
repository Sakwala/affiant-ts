        {
          "approver": "cy",
          "decision": "approve",
          "reason": null,
          "attestation": {
            "kind": "member",
            "id": "cy"
          }
        },
        {
          "approver": "ana",
          "decision": "approve",
          "reason": null,
          "attestation": {
            "kind": "member",
            "id": "ana"
          }
