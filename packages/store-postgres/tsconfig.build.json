{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Emit resolves workspace siblings through node_modules (their built .d.ts),
    // not through the source-path mapping the type-check config uses.
    "paths": {},
    // S-14 again: the driver's typings reach `node:stream`, so the published
    // surface is compiled with Node's declarations in scope. What keeps the
    // emitted code runtime-neutral is the import lint, not this list.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
