    "store": "memory",
    "gate": {
      "defaultTtlMs": 1800000,
      "authorization": {
        "allow": ["*"]
      },
      "policies": [
        {
          "id": "policy-mp",
          "version": "1.0.0",
          "declaredInputs": [],
