              "confidence": 0.9
            }
          }
        ]
      },
      {
        "kind": "decide",
        "at": "2026-09-28T09:01:00.000Z",
        "principal": {
          "kind": "member",
          "id": "ana"
        },
        "decision": {
          "kind": "approve"
        }
      }
    ],
    "step": {
      "kind": "decide",
      "at": "2026-09-28T09:02:00.000Z",
