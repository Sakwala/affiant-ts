{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/affiant-ts/spikes/claude-code-hook/dist/hook.js",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/affiant-ts/spikes/claude-code-hook/dist/bash-hook.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/affiant-ts/spikes/claude-code-hook/dist/outcome-hook.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/affiant-ts/spikes/claude-code-hook/dist/outcome-hook.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
